HOST=127.0.0.1
PORT=3001
DATABASE_PATH=.data/chat.sqlite
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_TTL_DAYS=7
LOG_LEVEL=info
TRUST_LOOPBACK_PROXY=false
DEFAULT_FRIEND_USERNAME=
# 管理员：uid 固定 1001（1000..9999 为特殊角色保留区，普通用户从 10001 起），
# 登录名默认 root。首次启动时若库里没有对应账号，会用 ADMIN_INITIAL_PASSWORD 建一个；
# 已有账号则一律不覆盖密码（改了环境变量也不会重置线上密码）。
ADMIN_UID=1001
ADMIN_USERNAME=root
ADMIN_INITIAL_PASSWORD=12345678
