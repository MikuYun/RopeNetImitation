# aitrance-chat 后端环境变量样例（HTTP 子路径形态：nginx 终结 TLS 场景请见下方注释）
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=/var/lib/aitrance/chat.sqlite
CORS_ORIGINS=http://mikuyun.xyz,http://www.mikuyun.xyz
SESSION_TTL_DAYS=7
LOG_LEVEL=info
TRUST_LOOPBACK_PROXY=true
DEFAULT_FRIEND_USERNAME=QJQ

# ---- SEC-01：传输与明文凭据防护 ----
# 本进程自己终结 TLS（Fastify 直接 https 监听）。两个变量必须成对出现，
# 只给一个或文件不可读 → 启动直接失败（fail-closed，不会静默退回明文）。
# nginx 终结 TLS 的部署不要设置这两项，改用 REQUIRE_HTTPS=true。
# TLS_CERT_PATH=/etc/letsencrypt/live/mikuyun.xyz/fullchain.pem
# TLS_KEY_PATH=/etc/letsencrypt/live/mikuyun.xyz/privkey.pem
#
# auto（默认）：仅当 TLS_CERT_PATH/TLS_KEY_PATH 生效时才要求 https。
# true：一律要求 https —— 反向代理终结 TLS、proxy→backend 是明文时**必须**显式设为 true。
# false：一律不要求（仅限本地 dev / 内网自担风险）。
# REQUIRE_HTTPS=true

# ---- 上传（附件）存储 ----
# 附件落盘目录。不配置时跟随 DATABASE_PATH：<库文件所在目录>/uploads
# （这样备份/迁移时数据与文件在同一次拷贝里，不容易漏）。
# 建议指到独立卷并配配额：上传与 SQLite 同卷时，写满会同时打挂数据库与上传。
# 注意 systemd 单元是 ProtectSystem=strict + ReadWritePaths=/var/lib/aitrance，
# 若改到该目录以外，必须同步把新路径加进 aitrance-chat.service 的 ReadWritePaths。
# UPLOADS_DIR=/var/lib/aitrance/uploads

# ---- 管理后台（v0.3.0 新增）----
# 系统管理员的 UID。服务启动时若该 UID 不存在会自动创建管理员账号
# （username 就是 UID 数字，显示名「系统管理员」）。**已存在则完全不动**，
# 也就是说改了这里的密码不会重置已有管理员的密码。取值 1000..9999，默认 1001。
# 管理员首次登录：账号名 1001（或用 UID 1001），密码见下一项。
# ADMIN_UID=1001
# 管理员首次创建时的初始密码，8..128 字符，默认 A454545asd@。
# **重要：当前版本没有「改密码」接口**，ensureAdmin 对已存在的管理员完全不动，
# 所以这个密码只能在**首次启动前**通过本变量决定；建好之后改这里不会生效。
# 因此首次部署前请把下面这行取消注释并换成你自己的强密码。
# 日志只打印 admin bootstrap: created|exists，不打印密码。
# ADMIN_INITIAL_PASSWORD=A454545asd@

# ---- BE-01：过期数据清理策略 ----
# 清理间隔（秒，1..3600，默认 30），随心跳运行；服务启动时也会先清一次。
# RETENTION_SWEEP_SECONDS=30
# 消息保留天数（0..3650；0 = 永不删除消息，默认 0）。设为 N 后删除 created_at 早于 N 天的消息，
# 注意这是物理删除，不可恢复，开启前请确认已有备份。
# RETENTION_MESSAGE_DAYS=0
