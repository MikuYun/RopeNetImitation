HOST=127.0.0.1
PORT=3001
DATABASE_PATH=.data/chat.sqlite
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_TTL_DAYS=7
LOG_LEVEL=info
TRUST_LOOPBACK_PROXY=false
DEFAULT_FRIEND_USERNAME=qjq
# 管理员：uid 固定 1001（1000..9999 为特殊角色保留区，普通用户从 10001 起），
# 登录名默认 root。首次启动时若库里没有对应账号，会用 ADMIN_INITIAL_PASSWORD 建一个；
# 已有账号则一律不覆盖密码（改了环境变量也不会重置线上密码）。
ADMIN_UID=1001
ADMIN_USERNAME=root
ADMIN_INITIAL_PASSWORD=12345678

# ---- 初始普通用户（v2 新增）----
# 需求：全新部署启动后除了管理员，还要有一个「初始普通用户」——
# 账号 QJQ / 昵称 柒玖柒 / 密码 A454545asd@，并且之后注册的新用户自动成为它的好友
# （好友靠上面的 DEFAULT_FRIEND_USERNAME 指向它，故默认填 qjq）。
# 与管理员同一套语义：**只在库里不存在该账号时创建一次，已存在则完全不动**
# （密码、昵称都不覆盖），所以改这里不会重置线上已有账号的密码。
# 把 SEED_USER_USERNAME 显式置空即可整体关闭这个预置账号（测试与嵌入用法靠它）。
SEED_USER_UID=10001
SEED_USER_USERNAME=qjq
SEED_USER_DISPLAY_NAME=柒玖柒
SEED_USER_INITIAL_PASSWORD=A454545asd@
