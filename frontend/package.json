{
  "name": "aitrance-chat",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "aitrance-chat —— 类微信网页聊天平台前端",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && node scripts/strip-mock-worker.mjs",
    "preview": "vite preview",
