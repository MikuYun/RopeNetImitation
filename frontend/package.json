    "test": "vitest run",
    "mock:ws": "node mocks/ws-server.mjs",
    "contract:ws": "node scripts/generate-ws-contract.mjs"
  },
  "dependencies": {
    "@vueuse/core": "^15.0.0",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vue-tsc": "^3.3.11",
    "ws": "^8.22.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
